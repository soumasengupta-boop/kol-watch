# Copy to .env for local runs. In GitHub, add these as repository secrets instead.
ANTHROPIC_API_KEY=
BRIGHTDATA_API_KEY=

# Weekly email via Resend (send-only key). REPORT_EMAIL_TO = the email you signed up to Resend with.
RESEND_API_KEY=
REPORT_EMAIL_TO=
# ...or via any SMTP server instead of Resend
# SMTP_USER=
# SMTP_PASSWORD=

# Optional overrides
# KOLWATCH_TAG_MODEL=claude-haiku-5-5
# KOLWATCH_DIGEST_MODEL=claude-sonnet-5-5
# BRIGHTDATA_POSTS_DATASET=gd_lyy3tktm25m4avu764
# KOLWATCH_LINKEDIN_POSTS_PER_PROFILE=15
